{
  "datasetCommonParams": {
    "dataset_root_dir": "./dataset",
    "abide": {
      "aligned": {
        "featurePath": "abide.pkl",
        "feature_dims": [
          48,
          6,
          10,
          256
        ],
        "train_samples": 871,
        "num_classes": 2,
        "language": "en",
        "KeyEval": "Loss"
      }
    }
  },
  "hpmd": {
    "commonParams": {
      "need_data_aligned": true,
      "need_model_aligned": true,
      "is_distill": true,
      "early_stop": 20,
      "use_bert": true,
      "use_finetune": true,
      "attn_mask": true,
      "update_epochs": 10,
      "fusion_method": "sum",
      "alpha": 5,
      "temperature": 0.05
    },
    "datasetParams": {
      "abide": {
        "attn_dropout_p": 0.2,
        "attn_dropout_a": 0.2,
        "attn_dropout_f": 0.2,
        "attn_dropout_c": 0.3,
        "relu_dropout": 0.0,
        "embed_dropout": 0.2,
        "res_dropout": 0.0,
        "dst_feature_dim_nheads": [
          256,
          8
        ],
        "batch_size": 16,
        "learning_rate": 0.0001,
        "nlevels": 4,
        "conv1d_kernel_size_p": 1,
        "conv1d_kernel_size_a": 1,
        "conv1d_kernel_size_f": 1,
        "conv1d_kernel_size_c": 1,
        "text_dropout": 0.5,
        "output_dropout": 0.5,
        "grad_clip": 0.6,
        "patience": 5,
        "weight_decay": 0.005,
        "transformers": "bert",
        "pretrained": "bert-base-uncased"
      }
    }
  }
}